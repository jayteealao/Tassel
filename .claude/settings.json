{
  "mcpServers": {
    "pw": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "tldr": {
      "type": "stdio",
      "command": "tldr-mcp",
      "args": [
        "--project",
        "."
      ],
      "env": {}
    }
  }
}